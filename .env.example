# Dardeck — пример .env (скопируйте в .env и раскомментируйте нужное)

# Токен бота от @BotFather (без него бот работает в dry-run):
# DARDECK_BOT_TOKEN=

# Путь к sqlite-пулу карточек (по умолчанию dardeck.db):
# DARDECK_DB_PATH=dardeck.db

# Снимок журнала оценок (по умолчанию ratings.json рядом с БД):
# DARDECK_RATINGS_SNAPSHOT=ratings.json

# Владелец-тест (Task 8): Telegram IDs через запятую — обход дневного/интервального
# гейта выдачи (соло и парного):
# DARDECK_TEST_USER_IDS=123456789,987654321
